# Force LF everywhere; .cfg fixtures especially must not be CRLF-corrupted on Windows.
* text=auto eol=lf
*.cfg text eol=lf
*.png binary
*.webp binary
*.jpg binary
*.woff2 binary

# Vendored native source keeps RARLAB's exact bytes; its notices are hash-checked.
apps/desktop/src-tauri/vendor/unrar-ng-sys/vendor/** -text
apps/desktop/src-tauri/vendor/unrar-ng-sys/execs-crate-changes.patch -text

