{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "execs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "execs",
      // Placeholder until `wrangler d1 create execs` is run against the real account;
      // local dev (Miniflare) works with any id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "R2_FILES", "bucket_name": "execs-files" },
    { "binding": "R2_MEDIA", "bucket_name": "execs-media" }
  ],
  "vars": {
    "APP_URL": "http://localhost:3000"
  }
  // Secrets (wrangler secret put / .dev.vars locally): STEAM_API_KEY, SESSION_SECRET
}
