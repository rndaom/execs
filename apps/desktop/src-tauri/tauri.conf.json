{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "execs",
  "version": "0.1.2",
  "identifier": "com.rndaom.execs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "execs",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": {
          "red": 18,
          "green": 18,
          "blue": 18,
          "alpha": 255
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://images.gamebanana.com https://raw.githubusercontent.com https://i.imgur.com https://*.imgur.com https://github.com https://*.githubusercontent.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "rndaom",
    "copyright": "Copyright (c) 2026 rndaom. MIT License.",
    "licenseFile": "../../../LICENSE",
    "resources": { "notices/*": "notices/" },
    "shortDescription": "Desktop companion for Team Fortress 2",
    "longDescription": "Profiles for your Team Fortress 2 setup: mastercomfig, binds, HUD, crosshair, viewmodels, sounds. Switches while the game is closed.",
    "homepage": "https://github.com/rndaom/execs",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NzFFNjdDNUZCRjA3QzMKUldUREI3OWZmT1p4MTgzZWhENFcvSEtqaGh6RUxiVEJibHNwNjBJMEphMkNaRm1QZFdzM2lCYVQK",
      "endpoints": [
        "https://github.com/rndaom/execs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
