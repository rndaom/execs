{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "execs",
  "version": "0.1.0",
  "identifier": "com.rndaom.execs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "execs",
        "width": 1200,
        "height": 800,
        "backgroundColor": { "red": 18, "green": 18, "blue": 18, "alpha": 255 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
