{
  "version": "v1",
  "capturesAvailable": false,
  "scenes": [
    {
      "id": "s1",
      "map": "pl_upward",
      "description": "BLU spawn exit overlook — buildings, terrain, skybox, props",
      "camera": "setpos and setang recorded during capture session (see tools/capture)"
    }
  ],
  "modules": [
    {
      "id": "shadows",
      "label": "Shadows",
      "mastercomfig": "shadows",
      "weight": 2,
      "levels": ["off", "low", "high"],
      "cvarRules": [
        { "level": "off", "when": { "r_shadows": "0" } },
        { "level": "low", "when": { "r_shadows": "1", "r_shadowrendertotexture": "0" } },
        { "level": "high", "when": { "r_shadows": "1", "r_shadowrendertotexture": "1" } }
      ],
      "capture": {
        "off": ["r_shadows 0"],
        "low": ["r_shadows 1", "r_shadowrendertotexture 0", "r_shadowmaxrendered 11"],
        "high": ["r_shadows 1", "r_shadowrendertotexture 1", "r_shadowmaxrendered 21"]
      }
    },
    {
      "id": "textures",
      "label": "Textures",
      "mastercomfig": "texture_quality",
      "weight": 3,
      "levels": ["low", "medium", "high", "ultra"],
      "cvarRules": [
        { "level": "low", "when": { "mat_picmip": "2" } },
        { "level": "medium", "when": { "mat_picmip": "1" } },
        { "level": "high", "when": { "mat_picmip": "0" } },
        { "level": "ultra", "when": { "mat_picmip": "-1" } }
      ],
      "capture": {
        "low": ["mat_picmip 2"],
        "medium": ["mat_picmip 1"],
        "high": ["mat_picmip 0"],
        "ultra": ["mat_picmip -1"]
      },
      "captureNote": "mat_picmip applies live; give it ~3s to stream textures back in"
    },
    {
      "id": "lighting",
      "label": "Lighting",
      "mastercomfig": "lighting",
      "weight": 3,
      "levels": ["low", "medium", "high"],
      "cvarRules": [
        { "level": "low", "when": { "mat_phong": "0", "mat_specular": "0" } },
        { "level": "medium", "when": { "mat_phong": "0" } },
        { "level": "high", "when": { "mat_phong": "1" } }
      ],
      "capture": {
        "low": ["mat_phong 0", "mat_specular 0", "mat_bumpmap 0"],
        "medium": ["mat_phong 0", "mat_specular 1", "mat_bumpmap 1"],
        "high": ["mat_phong 1", "mat_specular 1", "mat_bumpmap 1"]
      },
      "captureNote": "run mat_reloadallmaterials after changing these"
    },
    {
      "id": "water",
      "label": "Water",
      "mastercomfig": "water",
      "weight": 1,
      "levels": ["simple", "reflective"],
      "cvarRules": [
        { "level": "simple", "when": { "r_waterforcereflectentities": "0", "r_waterdrawreflection": "0" } },
        { "level": "simple", "when": { "r_waterdrawreflection": "0" } },
        { "level": "reflective", "when": { "r_waterdrawreflection": "1" } }
      ],
      "capture": {
        "simple": ["r_waterdrawreflection 0", "r_waterforcereflectentities 0"],
        "reflective": ["r_waterdrawreflection 1", "r_waterforcereflectentities 1"]
      },
      "captureNote": "scene 2 (koth_sawmill) only — s1 has no water"
    },
    {
      "id": "lod",
      "label": "Model detail",
      "mastercomfig": "lod",
      "weight": 1,
      "levels": ["low", "medium", "high"],
      "cvarRules": [
        { "level": "low", "when": { "r_rootlod": "2" } },
        { "level": "medium", "when": { "r_rootlod": "1" } },
        { "level": "high", "when": { "r_rootlod": "0" } }
      ],
      "capture": {
        "low": ["r_rootlod 2", "r_lod 2"],
        "medium": ["r_rootlod 1", "r_lod 1"],
        "high": ["r_rootlod 0", "r_lod -1"]
      },
      "captureNote": "needs map reload to fully apply"
    },
    {
      "id": "gibs",
      "label": "Gibs",
      "mastercomfig": "gibs",
      "weight": 1,
      "levels": ["off", "on"],
      "cvarRules": [
        { "level": "off", "when": { "violence_hgibs": "0" } },
        { "level": "on", "when": { "violence_hgibs": "1" } }
      ],
      "capture": {
        "off": ["violence_hgibs 0", "violence_agibs 0"],
        "on": ["violence_hgibs 1", "violence_agibs 1"]
      },
      "captureNote": "staged shot: bot soldier + crit rocket, same corner both times"
    },
    {
      "id": "ragdolls",
      "label": "Ragdolls",
      "mastercomfig": "ragdolls",
      "weight": 1,
      "levels": ["off", "on"],
      "cvarRules": [
        { "level": "off", "when": { "cl_ragdoll_physics_enable": "0" } },
        { "level": "on", "when": { "cl_ragdoll_physics_enable": "1" } }
      ],
      "capture": {
        "off": ["cl_ragdoll_physics_enable 0", "g_ragdoll_lvfadespeed 0"],
        "on": ["cl_ragdoll_physics_enable 1"]
      },
      "captureNote": "staged shot paired with the gibs capture"
    }
  ],
  "tiers": [
    {
      "id": "stock",
      "label": "Stock (game defaults)",
      "vector": { "shadows": "high", "textures": "high", "lighting": "high", "water": "reflective", "lod": "high", "gibs": "on", "ragdolls": "on" }
    },
    {
      "id": "low",
      "label": "Low (mastercomfig low)",
      "vector": { "shadows": "off", "textures": "low", "lighting": "low", "water": "simple", "lod": "low", "gibs": "off", "ragdolls": "off" }
    },
    {
      "id": "medium-low",
      "label": "Medium-low",
      "vector": { "shadows": "off", "textures": "medium", "lighting": "low", "water": "simple", "lod": "medium", "gibs": "off", "ragdolls": "off" }
    },
    {
      "id": "medium",
      "label": "Medium",
      "vector": { "shadows": "low", "textures": "medium", "lighting": "medium", "water": "simple", "lod": "medium", "gibs": "off", "ragdolls": "on" }
    },
    {
      "id": "high",
      "label": "High",
      "vector": { "shadows": "high", "textures": "high", "lighting": "high", "water": "reflective", "lod": "high", "gibs": "on", "ragdolls": "on" }
    },
    {
      "id": "ultra",
      "label": "Ultra",
      "vector": { "shadows": "high", "textures": "ultra", "lighting": "high", "water": "reflective", "lod": "high", "gibs": "on", "ragdolls": "on" }
    }
  ],
  "captureBaseline": {
    "description": "Every non-varied module pinned to medium while capturing a single module's levels",
    "cfg": [
      "sv_cheats 1",
      "cl_drawhud 0",
      "crosshair 0",
      "r_drawviewmodel 0",
      "hide_server 1",
      "jpeg_quality 100",
      "mat_queue_mode 2",
      "fov_desired 90",
      "r_shadows 1; r_shadowrendertotexture 0",
      "mat_picmip 1",
      "mat_phong 0; mat_specular 1; mat_bumpmap 1",
      "r_waterdrawreflection 0",
      "r_rootlod 1; r_lod 1"
    ]
  }
}
