{
  "name": "execs",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @execs/desktop dev",
    "build": "pnpm --filter @execs/desktop build",
    "desktop": "pnpm --filter @execs/desktop tauri",
